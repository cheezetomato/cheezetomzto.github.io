<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>웹 지뢰찾기</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            background-color: #f0f0f0;
            margin-top: 50px;
        }
        #game-container {
            background-color: #bdbdbd;
            padding: 20px;
            border: 3px solid;
            border-color: #fff #7b7b7b #7b7b7b #fff;
            box-shadow: 5px 5px 15px rgba(0,0,0,0.2);
        }
        .header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
            padding: 5px;
            background-color: #000;
            color: red;
            font-size: 24px;
            font-weight: bold;
            font-family: 'Courier New', Courier, monospace;
            border: 2px solid;
            border-color: #7b7b7b #fff #fff #7b7b7b;
        }
        #reset-btn {
            font-size: 20px;
            cursor: pointer;
            padding: 2px 10px;
        }
        #board {
            display: grid;
            grid-template-columns: repeat(9, 30px);
            gap: 0;
            border: 2px solid;
            border-color: #7b7b7b #fff #fff #7b7b7b;
        }
        .cell {
            width: 30px;
            height: 30px;
            background-color: #c0c0c0;
            border: 2px solid;
            border-color: #fff #7b7b7b #7b7b7b #fff;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: bold;
            font-size: 18px;
            cursor: pointer;
            user-select: none;
            box-sizing: border-box;
        }
        .cell:active:not(.revealed) {
            border: 1px solid #7b7b7b;
            background-color: #bdbdbd;
        }
        .cell.revealed {
            border: 1px solid #7b7b7b;
            background-color: #bdbdbd;
            cursor: default;
        }
        .cell.mine {
            background-color: red;
        }
    </style>
</head>
<body>

<div id="game-container">
    <div class="header">
        <div id="mine-count">010</div>
        <button id="reset-btn" onclick="initGame()">😊</button>
        <div id="timer">000</div>
    </div>
    <div id="board" oncontextmenu="return false;"></div>
</div>

<script>
    const ROWS = 9;
    const COLS = 9;
    const MINES = 10;
    
    let board = [];
    let isFirstClick = true;
    let isGameOver = false;
    let minesLeft = MINES;
    let revealedCount = 0;
    
    const boardElement = document.getElementById('board');
    const mineCountElement = document.getElementById('mine-count');
    const resetBtn = document.getElementById('reset-btn');

    // 숫자별 색상 지정
    const colors = ['', 'blue', 'green', 'red', 'darkblue', 'darkred', 'teal', 'black', 'gray'];

    function initGame() {
        boardElement.innerHTML = '';
        board = [];
        isFirstClick = true;
        isGameOver = false;
        minesLeft = MINES;
        revealedCount = 0;
        mineCountElement.textContent = String(minesLeft).padStart(3, '0');
        resetBtn.textContent = '😊';

        for (let r = 0; r < ROWS; r++) {
            let row = [];
            for (let c = 0; c < COLS; c++) {
                row.push({
                    isMine: false,
                    isRevealed: false,
                    isFlagged: false,
                    neighborMines: 0
                });
                
                const cell = document.createElement('div');
                cell.classList.add('cell');
                cell.id = `cell-${r}-${c}`;
                
                // 좌클릭
                cell.addEventListener('click', () => handleCellClick(r, c));
                // 우클릭 (깃발)
                cell.addEventListener('contextmenu', (e) => {
                    e.preventDefault();
                    handleRightClick(r, c);
                });
                
                boardElement.appendChild(cell);
            }
            board.push(row);
        }
    }

    function placeMines(firstR, firstC) {
        let placedMines = 0;
        while (placedMines < MINES) {
            let r = Math.floor(Math.random() * ROWS);
            let c = Math.floor(Math.random() * COLS);
            
            // 첫 클릭 위치와 이미 지뢰가 있는 곳에는 지뢰를 놓지 않음
            if (!board[r][c].isMine && (r !== firstR || c !== firstC)) {
                board[r][c].isMine = true;
                placedMines++;
            }
        }
        calculateNeighbors();
    }

    function calculateNeighbors() {
        for (let r = 0; r < ROWS; r++) {
            for (let c = 0; c < COLS; c++) {
                if (board[r][c].isMine) continue;
                let count = 0;
                for (let i = -1; i <= 1; i++) {
                    for (let j = -1; j <= 1; j++) {
                        let nr = r + i, nc = c + j;
                        if (nr >= 0 && nr < ROWS && nc >= 0 && nc < COLS && board[nr][nc].isMine) {
                            count++;
                        }
                    }
                }
                board[r][c].neighborMines = count;
            }
        }
    }

    function handleCellClick(r, c) {
        if (isGameOver || board[r][c].isRevealed || board[r][c].isFlagged) return;

        if (isFirstClick) {
            isFirstClick = false;
            placeMines(r, c);
        }

        revealCell(r, c);
        checkWin();
    }

    function handleRightClick(r, c) {
        if (isGameOver || board[r][c].isRevealed) return;

        let cellData = board[r][c];
        let cellElement = document.getElementById(`cell-${r}-${c}`);

        if (!cellData.isFlagged) {
            cellData.isFlagged = true;
            cellElement.textContent = '🚩';
            minesLeft--;
        } else {
            cellData.isFlagged = false;
            cellElement.textContent = '';
            minesLeft++;
        }
        
        mineCountElement.textContent = minesLeft >= 0 ? String(minesLeft).padStart(3, '0') : minesLeft;
    }

    function revealCell(r, c) {
        if (r < 0 || r >= ROWS || c < 0 || c >= COLS) return;
        let cellData = board[r][c];
        if (cellData.isRevealed || cellData.isFlagged) return;

        cellData.isRevealed = true;
        revealedCount++;
        let cellElement = document.getElementById(`cell-${r}-${c}`);
        cellElement.classList.add('revealed');

        if (cellData.isMine) {
            gameOver(false);
            return;
        }

        if (cellData.neighborMines > 0) {
            cellElement.textContent = cellData.neighborMines;
            cellElement.style.color = colors[cellData.neighborMines];
        } else {
            // 주변 지뢰가 0개면 주변 8칸도 연쇄적으로 열기 (Flood Fill)
            for (let i = -1; i <= 1; i++) {
                for (let j = -1; j <= 1; j++) {
                    revealCell(r + i, c + j);
                }
            }
        }
    }

    function checkWin() {
        if (!isGameOver && revealedCount === (ROWS * COLS - MINES)) {
            gameOver(true);
        }
    }

    function gameOver(isWin) {
        isGameOver = true;
        resetBtn.textContent = isWin ? '😎' : '😵';
        
        // 지뢰 모두 공개
        for (let r = 0; r < ROWS; r++) {
            for (let c = 0; c < COLS; c++) {
                if (board[r][c].isMine) {
                    let cellEl = document.getElementById(`cell-${r}-${c}`);
                    if (!board[r][c].isFlagged) {
                        cellEl.classList.add('revealed');
                        cellEl.textContent = '💣';
                        if (!isWin) cellEl.classList.add('mine'); // 밟은 지뢰 표시용
                    }
                } else if (board[r][c].isFlagged) {
                    // 잘못 꽂은 깃발 표시
                    let cellEl = document.getElementById(`cell-${r}-${c}`);
                    cellEl.textContent = '❌';
                }
            }
        }

        setTimeout(() => {
            alert(isWin ? '승리하셨습니다! 축하합니다!' : '지뢰를 밟았습니다. 게임 오버!');
        }, 100);
    }

    // 게임 초기화 실행
    initGame();
</script>

</body>
</html>
